# Secret-free production configuration example. Supply FANBBS_DATABASE_URL
# from the deployment platform's secret store; never commit a real value.
FANBBS_DATABASE_DRIVER=postgres
FANBBS_ADDR=127.0.0.1:8080
FANBBS_SEED_DEMO=false
FANBBS_BLOB_DIR=/var/lib/fanbbs/blobs
FANBBS_MEDIA_RETENTION=24h
FANBBS_MEDIA_CLEANUP_LIMIT=100

